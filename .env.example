# AppForge AI Studio — environment variables.
# Copy to .env and fill in. NEVER commit .env (it holds secrets).

# ---- Studio backend ----
# API listen port.
PORT=3001
# Data root: projects, appforge.db (SQLite), revisions, logs. Absolute path in
# production (e.g. /data/appforge inside Docker).
DATA_DIR=./data
# If set, every /api/* route requires "Authorization: Bearer <token>".
# Generated web apps under /p/* remain public so their full Oracle URLs can be shared.
# Set a long random value in production.
APPFORGE_ADMIN_TOKEN=
# Frontend origin allowed to call the API (default "*" in dev).
CORS_ORIGIN=*
# Chromium path for mandatory browser verification. Docker sets this automatically.
# Outside Docker, install Chromium/Chrome and set its absolute executable path.
APPFORGE_BROWSER_EXECUTABLE=
# Enforced by the production compose; do not enable for local development.
APPFORGE_PRODUCTION=

# ---- Docker deployment (Oracle / Linux production only) ----
# Numeric group owning /var/run/docker.sock on the host:
#   stat -c %g /var/run/docker.sock
DOCKER_GID=998
# Full deployment pipelines admitted concurrently by the shared driver.
APPFORGE_MAX_CONCURRENT_DEPLOYS=1
# `:80` works by IP. Set a DNS name only after it resolves to the Oracle VM.
APPFORGE_SITE_ADDRESS=:80

# ---- LLM (configurable without code changes) ----
# groq | openrouter
LLM_PROVIDER=groq
# Model id. Empty = provider default. Change it from Settings in the UI.
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8000
# HTTP timeout for LLM calls, in ms.
LLM_TIMEOUT_MS=120000
# API keys. NEVER exposed to the frontend.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# =1 enables a deterministic FAKE LLM provider (fixed tool-call sequence:
# copy template, build, preview). FOR AUTOMATED TESTS ONLY — never real AI.
APPFORGE_LLM_STUB=

# ---- Studio frontend (build-time, apps/studio) ----
# URL where the browser can reach the backend (e.g. http://localhost:3001).
VITE_API_URL=http://localhost:3001
