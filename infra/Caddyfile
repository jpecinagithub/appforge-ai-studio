# Default `:80` certifies the Oracle/IP flow without a domain. Set
# APPFORGE_SITE_ADDRESS only after its DNS record resolves to this host.
{$APPFORGE_SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	reverse_proxy studio:3001 {
		health_uri /healthz
		health_interval 15s
		health_timeout 5s
	}

	log {
		output stdout
		format json
	}
}
